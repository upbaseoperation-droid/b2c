{
  "name": "web-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --max-old-space-size=8192 node_modules/next/dist/bin/next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "ui:check": "node scripts/ui-check.mjs",
    "ui:codemod": "node scripts/ui-codemod.mjs",
    "ui:audit": "node scripts/ui-audit-browser/run.mjs",
    "test": "tsx --test tests/*.test.ts",
    "db:push": "node --env-file=.env.local node_modules/prisma/build/index.js db push",
    "db:status": "node --env-file=.env.local node_modules/prisma/build/index.js migrate status",
    "db:sync": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/supabase-sync-all.ts",
    "db:inspect": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/supabase-sync-all.ts --inspect"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.64.1",
    "prisma": "^6.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
