# ==============================================================================
# UPBASE B2C MARKETING OPERATIONS HUB — SUPABASE & PRISMA CONFIGURATION
# ==============================================================================

# 1. PRISMA & SUPABASE POSTGRESQL CONNECTION
# Connect to Supabase via connection pooling with pgBouncer (Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-SUPABASE-PROJECT]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for database migrations (Port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-SUPABASE-PROJECT]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 2. SUPABASE API & AUTH KEYS
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-SUPABASE-PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# 3. APP CONFIGURATION
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. LARK OPEN PLATFORM SSO & OAUTH 2.0 (UPBASE ENTERPRISE)
# Đăng ký app tại: https://open.larksuite.com/ (Developer Console)
# Cấu hình Redirect URL: http://localhost:3000/api/auth/lark/callback
LARK_APP_ID="cli_a1b2c3d4e5f6g7h8"
LARK_APP_SECRET="your-lark-app-secret-here"
LARK_DOMAIN="open.larksuite.com"
LARK_REDIRECT_URI="http://localhost:3000/api/auth/lark/callback"

# 5. TÍCH HỢP KALODATA ENTERPRISE OPEN API (CHỈ SỐ THƯƠNG MẠI & DOANH SỐ KOC TIKTOK SHOP)
# Để trống hoặc chưa cấu hình: Hệ thống tự động chuyển sang chế độ mô phỏng thị trường Việt Nam (Sandbox)
# Khi ký hợp đồng Enterprise với Kalodata: Điền secret key được cung cấp để kích hoạt luồng trực tiếp
KALODATA_API_KEY="your-kalodata-enterprise-secret-key"
KALODATA_BASE_URL="https://api.kalodata.com/open-api/v1"
KALODATA_REGION="VN"
KALODATA_CURRENCY="VND"

# 6. QUẢN LÝ HỢP ĐỒNG TRONG B2C
# Điền trên máy chủ; không đưa khóa thật vào Git.
AUTH_SECRET=""
LARK_TENANT_KEY=""
CONTRACT_ACCESS_JSON="[]"
CONTRACT_STORAGE="postgres"
# Thư mục chứa 8 mẫu Word do pháp chế quản lý, cần mount vào máy chủ.
CONTRACT_TEMPLATE_DIR=""
CONTRACT_AI_ENABLED="false"
CONTRACT_AI_MODEL=""
GEMINI_API_KEY=""
WESIGN_ENV="demo"
WESIGN_CLIENT_ID=""
WESIGN_CLIENT_SECRET=""
WESIGN_AMIS_SID=""
WESIGN_SYNC_SECRET=""
# Chỉ điền mapping trạng thái tài liệu được MISA xác nhận.
WESIGN_STATUS_MAP="{}"

# 7. LƯU TRỮ TỆP THƯƠNG HIỆU (CLOUDFLARE R2 OBJECT STORAGE)
# Nếu để trống, hệ thống tự động lưu tệp vào thư mục cục bộ .brand-data/files khi phát triển.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="upbase-b2c-brands"
# Tùy chọn: ghi đè endpoint S3 của R2 (mặc định: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=""
# Tùy chọn: domain public gắn với R2 bucket nếu muốn phục vụ link trực tiếp
R2_PUBLIC_URL=""

# 7. CRAWLER-WORKER (KIỂM TRA LINK AIR ĐA NỀN TẢNG) — xem crawler-worker/README.md
CRAWLER_WORKER_URL="http://localhost:8790"
CRAWLER_WORKER_TOKEN=""

# GỬI DANH SÁCH KOC LÊN GOOGLE SHEET CỦA BRAND (tài khoản dịch vụ Google, quyền Google Sheets API)
# Để trống: nút Gửi lên Google Sheet bị khóa, vẫn tải được file Excel.
# Sheet của Brand phải chia sẻ quyền chỉnh sửa cho email này. Khóa riêng viết trên một dòng, xuống dòng là \n.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# SỐ LIỆU DAILY THEO VIDEO TỪ UPAFFILIATE (tính D14 / D30 / D60 của Job từ ngày air)
# Để trống: nút Đồng bộ GMV / Đơn hàng báo chưa cấu hình, không tự sinh số.
# API trả { data: [{ date, video_id, views, orders, gmv }] } — số phát sinh trong ngày, không cộng dồn.
UPAFFILIATE_DAILY_API_URL=""
UPAFFILIATE_API_KEY=""

# 7. DATA WAREHOUSE (báo cáo air Video kênh Brand, khớp theo video_id)
# Để trống thì báo cáo hiển thị "Chưa kết nối", không điền số giả.
DW_API_BASE_URL=""
DW_API_TOKEN=""
DW_VIDEO_VIEW="v_b2c_video_performance"
