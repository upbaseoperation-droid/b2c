datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================================
// 1. KHO TRẠNG THÁI ĐỒNG BỘ TRUNG TÂM & HỒ SƠ ĐỘC LẬP (SHARED RECORDS & HUBS)
// =========================================================================

// Kho Key-Value JSON trung tâm có kiểm soát phiên bản (optimistic concurrency `revision`).
// Lưu trữ các bảng nghiệp vụ: deal-board, listing-board, content-plan, self-channel-board,
// koc-directory-changes, master-catalog, access-policy, payment-slips-v1, zalo-bot...
model AppSharedRecord {
  key      String @id
  revision Int    @default(0)
  data     Json
}

// Hồ sơ thương hiệu; quyền sửa theo từng mục được kiểm tra bởi API.
model BrandProfileRecord {
  key       String   @id
  revision  Int      @default(1)
  data      Json
  updatedAt DateTime @default(now()) @db.Timestamp(3)
}

// Hồ sơ Contract Hub; quyền truy cập được kiểm tra bởi API, không truy cập từ client.
model ContractHubRecord {
  id        String   @id
  revision  Int      @default(1)
  data      Json
  updatedAt DateTime @default(now()) @db.Timestamp(3)

  @@index([updatedAt])
}

model ContractWeSignBinding {
  documentId String @id
  contractId String
}

model ContractTemplateSnapshot {
  hash       String @id
  templateId String
  file       Bytes
}

model PartnerHubThread {
  id        String   @id
  data      Json
  updatedAt DateTime @default(now()) @db.Timestamp(3)

  @@index([updatedAt])
}

// =========================================================================
// 2. ENUMS NGHIỆP VỤ CỐT LÕI (DÙNG CHO GIAN HÀNG & HỒ SƠ KOC)
// =========================================================================

enum ServiceModel {
  FULL_SERVICE          // Quản trị toàn diện (KOC + Content + Ads + Live)
  AFFILIATE_ONLY        // Chỉ vận hành mạng lưới KOC Affiliate
  LIVESTREAM_DEDICATED  // Đội ngũ chuyên biệt Livestream Inhouse/CTV
}

enum AccountStatus {
  ONBOARDING            // Khởi tạo gian hàng & cấu hình ban đầu
  ACTIVE                // Đang vận hành chiến dịch thường xuyên
  MAINTENANCE           // Duy trì tối thiểu / Giai đoạn thấp điểm
  OFFBOARDED            // Tạm dừng hoặc kết thúc dịch vụ
}

enum KocTier {
  TIER_1_CELEB          // KL7 (>30M VNĐ)
  TIER_2_MACRO          // KL6 (10M - 30M VNĐ)
  TIER_3_MICRO          // KL4 - KL5 (3M - 10M VNĐ)
  TIER_4_AFFILIATE      // TAP, KL1 - KL3 (<3M VNĐ hoặc thuần hoa hồng)
}

// Khung lương (KL) - Chuẩn hóa Sheet 3.1 & 5.6
enum SalaryGrade {
  TAP_UP_AFFILIATE      // TAP UpAffiliate (0đ - thuần affiliate)
  KL1                   // 0 - 500.000 VNĐ
  KL2                   // 500.000 - 1.500.000 VNĐ
  KL3                   // 1.500.000 - 3.000.000 VNĐ
  KL4                   // 3.000.000 - 5.000.000 VNĐ
  KL5                   // 5.000.000 - 10.000.000 VNĐ
  KL6                   // 10.000.000 - 30.000.000 VNĐ
  KL7                   // > 30.000.000 VNĐ (Celeb / Mega)
  TAP_EXTERNAL          // TAP đối tác ngoài / Agency MCN
}

// Phân nhóm Creator theo vai trò chiến lược (Sheet 3.2 Col 81 & 5.6)
enum CreatorSegment {
  MASSIVE_CREATOR       // TAP, KL1, KL2, KL3 (< 3M)
  MID_CREATOR           // KL4, KL5 (3M - 10M)
  KEY_CREATOR           // KL6 (10M - 30M)
  TOP_CREATOR           // KL7 (> 30M)
}

// Ngành hàng / Lĩnh vực KOC (Sheet 3.2 Col 87 & 5.4)
enum KocCategory {
  PERSONAL_CARE         // Mỹ phẩm, chăm sóc da liễu, tóc, body
  MOM_AND_BABY          // Mẹ & Bé, phụ nữ mang thai, bỉm sữa
  REVIEWER              // Reviewer chuyên sâu đa sản phẩm
  LIFESTYLE             // Đời sống, thể thao, wellness
  FASHION               // Thời trang, phụ kiện
  ELHA                  // Điện gia dụng, thiết bị thông minh, đồ gia đình
  FB                    // Thực phẩm, đồ uống (F&B), ẩm thực
  SOCIAL_COMEDIAN       // Giải trí, kịch bản hài hước, tình huống sáng tạo
  TRAVEL_HOSPITALITY    // Du lịch, nghỉ dưỡng, khách sạn, dịch vụ
}

// =========================================================================
// 3. QUẢN LÝ KẾ HOẠCH THÁNG (MONTHLY PLAN) — PHIÊN BẢN CHỐT & SỔ TRAO ĐỔI
// =========================================================================

// Kế hoạch tháng đang làm việc (bản nháp hiện hành). Toàn bộ cấu trúc phân rã
// (items, signOff, pillars...) lưu ở cột `data` để giữ nguyên hình dạng
// InputPlanBreakdownState phía giao diện; các cột còn lại để lọc/báo cáo.
model MonthlyPlan {
  id                  String   @id // Giữ nguyên mã kế hoạch phía giao diện (PLAN-2026-10-xxxx)
  title               String
  brandName           String
  storeId             String?
  month               String   // 2026/10
  week                String?
  pic                 String?
  growthPic           String?
  mediaPic            String?
  bookingLeader       String?
  status              String   @default("DRAFT")
  currentVersionCode  String   @default("v1.0")
  isVersionLocked     Boolean  @default(false)
  totalTargetBudget   Decimal  @default(0) @db.Decimal(14, 2)
  budgetAdsTotal      Decimal  @default(0) @db.Decimal(14, 2)
  targetGmv           Decimal  @default(0) @db.Decimal(14, 2)
  totalTargetContents Int      @default(0)
  sourceSystem        String   @default("WEB_ADMIN") // WEB_ADMIN | LARKBASE
  larkRecordId        String?  @unique // record_id của bản ghi kế hoạch đã duyệt trên Larkbase
  larkAppToken        String?  // app_token của Bitable Larkbase
  larkTableId         String?  // table_id của bảng Kế hoạch B2C Booking trên Larkbase
  larkApprovalCode    String?  // Mã phiếu phê duyệt / Trạng thái duyệt trên Lark
  larkSyncedAt        DateTime? // Thời điểm kéo từ Larkbase về hệ thống gần nhất
  data                Json     // InputPlanBreakdownState (không gồm versionSnapshots & discussions)
  revision            Int      @default(1) // Chống ghi đè khi nhiều người cùng sửa
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  versionSnapshots MonthlyPlanVersionSnapshot[]
  discussions      MonthlyPlanDiscussion[]
  larkbaseRecords  LarkbaseBookingPlanRecord[]

  @@index([month])
  @@index([brandName])
  @@index([status])
  @@index([sourceSystem])
}

// Bảng hứng Kế hoạch B2C Booking kéo về từ Larkbase khi đã được duyệt (Chuẩn File 4.1 & 4.1.1)
model LarkbaseBookingPlanRecord {
  id                      String       @id @default(uuid())
  larkRecordId            String       @unique // record_id gốc trên Larkbase Bitable
  larkAppToken            String       // app_token của Bitable
  larkTableId             String       // table_id của bảng kế hoạch trên Larkbase
  planId                  String?      // Liên kết sang bảng MonthlyPlan (VD: PLAN-2026-10-...)
  plan                    MonthlyPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  month                   String       // Chu kỳ tháng (VD: 2026/10)
  week                    String?      // Tuần áp dụng (VD: W41, W42... hoặc Cả tháng)
  versionCode             String       @default("v1.0") // Phiên bản kế hoạch trong tháng (v1.0, v1.1, v1.2...)
  versionName             String?      // Tên đợt kế hoạch (Bản chốt đầu tháng / Điều chỉnh Mega Sale / Top-up...)
  storeName               String       // Tên gian hàng chuẩn (VD: ClubClio_TikTok_E2E-C)
  brandName               String       // Thương hiệu
  platform                String       @default("TikTok Shop") // TikTok Shop, Shopee, Lazada...
  isB2cManaged            Boolean      @default(true) // Cột 25 File 4.1: B2C phụ trách = 1
  b2cPic                  String       // Chuyên viên B2C thực thi (PIC)
  bookingLeader           String?      // Cột 55 File 4.1.1: Nguyễn Thị Ngọc Tâm hoặc null (Duyệt trực tiếp)
  growthPic               String?      // Nhân sự Growth giao số
  mediaPic                String?      // Nhân sự Media nhận gói Ads
  approvalStatus          String       @default("LEAD_APPROVED") // LEAD_APPROVED, BRAND_APPROVED, APPROVED, IN_EXECUTION
  larkApprovalInstanceId  String?      // Mã quy trình duyệt trên Lark Approval / Base
  approvedBy              String?      // Người ký duyệt (VD: Đặng Thị Yến Nhi)
  approvedAt              DateTime?    // Thời điểm được duyệt trên Larkbase

  // Bóc tách chỉ tiêu tài chính Gross / Net & 4 đầu việc B2C
  budgetGross             Decimal      @default(0) @db.Decimal(14, 2)
  budgetNet               Decimal      @default(0) @db.Decimal(14, 2) // Hạn mức Order Net kế toán kiểm soát
  budgetAdsTotal          Decimal      @default(0) @db.Decimal(14, 2) // Gói Ads tổng giao Media
  targetGmv               Decimal      @default(0) @db.Decimal(14, 2)
  totalTargetVideos       Int          @default(0)

  // 1. Đầu việc 1: Video Affiliate KOC trả phí (Paid)
  affiliatePaidVideos     Int          @default(0)
  affiliatePaidBudgetNet  Decimal      @default(0) @db.Decimal(14, 2)
  kocTierBreakdown        Json?        // Phân bổ theo khung lương { kl1, kl2, kl3, kl4, kl5, kl6, kl7 }

  // 2. Đầu việc 2: Suất gửi mẫu FOC miễn phí (0đ)
  focFreeVideos           Int          @default(0)
  focPic                  String?      // Chuyên viên phụ trách FOC (VD: Trần Thị Hảo)

  // 3. Đầu việc 3: Video kênh Brand tự xây (Self-channel)
  selfChannelVideos       Int          @default(0)
  selfChannelBudgetNet    Decimal      @default(0) @db.Decimal(14, 2)

  // 4. Đầu việc 4: Đa sàn / Kênh khác & Livestream
  multiPlatformVideos     Int          @default(0)
  multiPlatformBudgetNet  Decimal      @default(0) @db.Decimal(14, 2)
  liveSessions            Int          @default(0)
  liveBudgetNet           Decimal      @default(0) @db.Decimal(14, 2)

  rawFields               Json         // Nguyên bản fields trả về từ Larkbase Bitable API để đối soát
  syncSource              String       @default("LARKBASE_API") // LARKBASE_API | LARKBASE_WEBHOOK | MANUAL_IMPORT
  syncedBy                String?
  syncedAt                DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([month, storeName])
  @@index([brandName])
  @@index([approvalStatus])
  @@index([planId])
}

// Bản chụp phiên bản đã chốt (v1.0 Baseline, v1.1...). Chỉ thêm mới, không sửa/xóa.
model MonthlyPlanVersionSnapshot {
  id                String      @id @default(uuid())
  planId            String
  plan              MonthlyPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  clientId          String      // id snapshot phía giao diện
  versionCode       String
  versionName       String
  createdBy         String
  creatorRole       String
  changeReason      String?
  totalTargetBudget Decimal     @db.Decimal(14, 2)
  budgetAdsTotal    Decimal     @db.Decimal(14, 2)
  targetGmv         Decimal     @db.Decimal(14, 2)
  data              Json        // PlanVersionSnapshot đầy đủ (items + signOffRecord)
  lockedAt          DateTime    @default(now())

  @@unique([planId, clientId])
  @@index([planId, versionCode])
}

// Sổ biên bản & lịch sử trao đổi 4 bên. Chỉ thêm mới, không sửa/xóa.
model MonthlyPlanDiscussion {
  id          String      @id @default(uuid())
  planId      String
  plan        MonthlyPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  clientId    String      // id tin nhắn phía giao diện
  authorName  String
  authorRole  String
  authorTitle String?
  type        String
  content     String
  data        Json        // PlanDiscussionMessage đầy đủ (tags, budgetDiff)
  postedAt    DateTime
  createdAt   DateTime    @default(now())

  @@unique([planId, clientId])
  @@index([planId, postedAt])
}

// =========================================================================
// 4. DANH MỤC GIAN HÀNG B2C, HỒ SƠ KOC & ĐỐI SOÁT TIKTOK SELLER CENTER
// =========================================================================

model StorePortfolio {
  id                        String                           @id @default(uuid())
  storeOperationId          String?                          @unique // Mã vận hành: SO-B2C-001..069
  brandName                 String
  storeName                 String                           @unique
  platform                  String                           // TikTok Shop, Shopee Mall, Lazada
  storeUrl                  String?
  serviceModel              ServiceModel                     @default(FULL_SERVICE)
  difficultyTier            String                           @default("Tiêu chuẩn") // Cơ bản (1.0), Tiêu chuẩn (1.2), Vừa (1.4), Khó (1.6)
  difficultyMultiplier      Float                            @default(1.2)
  accountStatus             AccountStatus                    @default(ACTIVE)
  category                  String                           // Dược mỹ phẩm, Mẹ & Bé, Skincare...
  monthlyTargetGmv          Decimal                          @default(0) @db.Decimal(14, 2)
  monthlyBudget             Decimal                          @default(0) @db.Decimal(14, 2)

  // Bóc tách chỉ tiêu Order Growth (File 4.1 & 4.1.1) & Đối soát thực chi (File 3.2)
  isB2cManaged              Boolean                          @default(true)
  hasBookingLeader          Boolean                          @default(false)
  bookingLeader             String?                          // Cột 55 File 4.1.1 (Nguyễn Thị Ngọc Tâm) hoặc null (Trực tiếp Trưởng Phòng)
  budgetGross               Decimal                          @default(0) @db.Decimal(14, 2)
  budgetNet                 Decimal                          @default(0) @db.Decimal(14, 2)
  budgetAffiliateGross      Decimal                          @default(0) @db.Decimal(14, 2)
  budgetAffiliateNet        Decimal                          @default(0) @db.Decimal(14, 2)
  budgetSelfChannelGross    Decimal                          @default(0) @db.Decimal(14, 2)
  budgetSelfChannelNet      Decimal                          @default(0) @db.Decimal(14, 2)
  budgetLive                Decimal                          @default(0) @db.Decimal(14, 2)
  targetPaidVideos          Int                              @default(0)
  targetFocVideos           Int                              @default(0)
  targetSelfChannelContents Int                              @default(0)
  targetLiveSessions        Int                              @default(0)
  actualSpentNet            Decimal                          @default(0) @db.Decimal(14, 2)
  actualAiredVideos         Int                              @default(0)
  financialRiskStatus       String                           @default("NORMAL") // NORMAL, OVERBUDGET, UNBUDGETED, SLOW_BURN
  financialRiskNotes        String?

  // Phân định 2 chủ tài khoản rõ ràng:
  accountOwnerName          String                           // Account/Growth Owner (Chịu trách nhiệm doanh số & quan hệ khách hàng)
  b2cOwnerName              String                           // B2C Ops Owner (Chịu trách nhiệm vận hành nội dung & booking)

  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt

  tiktokConnection          TikTokShopConnection?
  tiktokDailyMetrics        TikTokSellerDailyMetric[]
  tiktokAdsCampaigns        TikTokAdsCampaignReport[]
  tiktokVideoSnapshots      TikTokVideoPerformanceSnapshot[]

  @@index([accountStatus])
  @@index([serviceModel])
  @@index([brandName])
  @@index([financialRiskStatus])
}

// Master Hồ sơ Creator / KOC
model KocProfile {
  id               String         @id @default(uuid())
  channelId        String         @unique // @megauriviu
  stageName        String
  realName         String?
  tier             KocTier        @default(TIER_3_MICRO)

  // 4 trường phân loại cốt lõi (Sheet 3.1 & 3.2 & 5.4 & 5.6)
  salaryGrade      SalaryGrade    @default(KL3)             // 1. KL (Khung lương net)
  segment          CreatorSegment @default(MASSIVE_CREATOR) // 2. Segment (Massive, Mid, Key, Top)
  tepKenh          String         @default("Review Nữ")     // 3. Tệp Kênh (25 tệp chuẩn)
  kocCategory      KocCategory    @default(PERSONAL_CARE)   // 4. KOC category (9 nhóm ngành)

  mainChannel      String         @default("TIKTOK")
  channelUrl       String
  followersCount   Int            @default(0)
  avgViews         Int            @default(0)
  niche            String?        // Mô tả chi tiết ngách kênh
  phone            String?
  zalo             String?
  email            String?
  cccd             String?
  taxCode          String?
  bankName         String?
  bankAccount      String?
  rateCardVideo    Decimal?       @db.Decimal(12, 2)
  reliabilityScore Float          @default(10.0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([channelId])
  @@index([tier])
  @@index([salaryGrade])
  @@index([segment])
  @@index([kocCategory])
  @@index([tepKenh])
  @@index([niche])
}

// Cấu hình kết nối Gian hàng TikTok Shop Seller Center & TikTok Ads
model TikTokShopConnection {
  id               String          @id @default(uuid())
  storePortfolioId String?         @unique
  storePortfolio   StorePortfolio? @relation(fields: [storePortfolioId], references: [id], onDelete: SetNull)
  shopId           String          @unique // ID định danh Shop trên TikTok Seller Center
  shopCipher       String?         // Cipher dùng gọi TikTok Partner API
  sellerName       String          // Tên hiển thị trên TikTok Seller
  storeName        String          @unique // Tên chuẩn trong 69 gian hàng B2C (VD: Fresh_TikTok_E2E-C)
  brandName        String
  advertiserIds    String[]        // Danh sách ID tài khoản quảng cáo TikTok Ads gắn với gian hàng
  syncStatus       String          @default("ACTIVE") // ACTIVE, TOKEN_EXPIRED, DISCONNECTED
  lastSyncedAt     DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([brandName])
  @@index([syncStatus])
}

// Bảng hứng doanh số & chỉ số vận hành Gian hàng theo ngày từ TikTok Seller Center
model TikTokSellerDailyMetric {
  id               String          @id @default(uuid())
  storePortfolioId String?
  storePortfolio   StorePortfolio? @relation(fields: [storePortfolioId], references: [id], onDelete: SetNull)
  storeName        String
  brandName        String
  reportDate       DateTime        @db.Date
  gmv              Decimal         @default(0) @db.Decimal(14, 2)
  nmv              Decimal         @default(0) @db.Decimal(14, 2)
  refundAmount     Decimal         @default(0) @db.Decimal(14, 2)
  ordersCount      Int             @default(0)
  buyersCount      Int             @default(0)
  affiliateGmv     Decimal         @default(0) @db.Decimal(14, 2)
  selfChannelGmv   Decimal         @default(0) @db.Decimal(14, 2)
  liveGmv          Decimal         @default(0) @db.Decimal(14, 2)
  adsSpend         Decimal         @default(0) @db.Decimal(14, 2)
  adsGmv           Decimal         @default(0) @db.Decimal(14, 2)
  roas             Float           @default(0)
  syncedAt         DateTime        @default(now())

  @@unique([storeName, reportDate])
  @@index([brandName, reportDate])
  @@index([storePortfolioId])
}

// Bảng hứng báo cáo Chiến dịch Quảng cáo Sản phẩm & Livestream (PGM / LGM) từ TikTok Seller
model TikTokAdsCampaignReport {
  id                String          @id @default(uuid())
  campaignId        String
  campaignName      String
  storePortfolioId  String?
  storePortfolio    StorePortfolio? @relation(fields: [storePortfolioId], references: [id], onDelete: SetNull)
  storeName         String
  brandName         String
  reportPeriod      String          // VD: "2026-10-01 ~ 2026-10-08"
  sourceFileName    String?
  cost              Decimal         @default(0) @db.Decimal(14, 2)
  gmv               Decimal         @default(0) @db.Decimal(14, 2)
  orders            Int             @default(0)
  roas              Float           @default(0)
  cpa               Decimal         @default(0) @db.Decimal(14, 2)
  impressions       Int             @default(0)
  clicks            Int             @default(0)
  ctr               Float           @default(0)
  cvr               Float           @default(0)
  hookRate2s        Float           @default(0)
  completionRate100 Float           @default(0)
  videoCount        Int             @default(0)
  syncedAt          DateTime        @default(now())

  @@unique([campaignId, reportPeriod])
  @@index([storeName])
  @@index([brandName])
  @@index([storePortfolioId])
}

// Bảng hứng hiệu suất từng Video (Creative TikTok Seller & Đối soát đơn Booking File 3.2)
model TikTokVideoPerformanceSnapshot {
  id                String          @id @default(uuid())
  videoId           String          // ID Video TikTok hoặc Mã định danh bài đăng
  bookingCode       String?         // Mã đơn book File 3.2 (VD: BO26_0909_SU23)
  bookingDealId     String?         // Mã tham chiếu đơn Booking nếu có
  storePortfolioId  String?
  storePortfolio    StorePortfolio? @relation(fields: [storePortfolioId], references: [id], onDelete: SetNull)
  storeName         String
  brandName         String
  campaignName      String?
  productId         String?
  productName       String?
  videoTitle        String?
  tiktokAccount     String          // ID kênh KOC / Tài khoản TikTok đăng bài
  pic               String?         // Chuyên viên thực thi (PIC) phụ trách đơn book
  format            String?         // Booking Video KOC / Booking Video kênh Brand / Booking Livestream KOC
  videoType         String?         // Review Voice, Unbox Voice, Video remix, Nhạc text...
  salaryGradeKl     String?         // TAP UpAffiliate (0đ), KL1 -> KL7
  authorizationType String?         // TikTok Shop OfficialAccount, TikTok account (Marketing)...
  airDate           String?
  bookingCostNet    Decimal         @default(0) @db.Decimal(14, 2) // Cát-xê duyệt chi trong File 3.2
  adsSpend          Decimal         @default(0) @db.Decimal(14, 2) // Chi phí chạy Ads trên TikTok Seller
  sellerGmv         Decimal         @default(0) @db.Decimal(14, 2) // Doanh thu GMV thực thu từ TikTok Seller
  sellerOrders      Int             @default(0)                    // Số đơn hàng thực thu
  cpa               Decimal         @default(0) @db.Decimal(14, 2)
  roas              Float           @default(0)
  viewsCount        Int             @default(0)
  impressions       Int             @default(0)
  clicks            Int             @default(0)
  ctr               Float           @default(0)
  cvr               Float           @default(0)
  hookRate2s        Float           @default(0)
  viewRate6s        Float           @default(0)
  completionRate100 Float           @default(0)
  pipelineStatus    String?         // Làm ĐNTT, Gửi hàng, Tạm ứng, Done...
  slaWarning        String?
  linkAir           String?
  reportPeriod      String          @default("2026-10")
  syncedAt          DateTime        @default(now())

  @@unique([videoId, reportPeriod])
  @@index([bookingCode])
  @@index([storeName])
  @@index([brandName])
  @@index([pic])
  @@index([salaryGradeKl])
  @@index([storePortfolioId])
}
