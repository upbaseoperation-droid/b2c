# Cổng HTTP của worker
PORT=8790

# Token dùng chung với web-admin (CRAWLER_WORKER_TOKEN). Bắt buộc khi deploy.
WORKER_TOKEN=

# Proxy (khuyến nghị proxy residential Việt Nam). Bật cả 2 dòng dưới khi có proxy:
# HTTPS_PROXY=http://user:pass@proxy-host:port
# NODE_USE_ENV_PROXY=1

# Tinh chỉnh (mặc định đã hợp lý)
# HTTP_TIMEOUT_MS=12000
# HTTP_RETRIES=2
# CACHE_TTL_SECONDS=600
# PER_PLATFORM_CONCURRENCY=3
# PER_PLATFORM_MIN_GAP_MS=400
# MAX_LINKS_PER_REQUEST=100
