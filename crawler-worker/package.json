{
  "name": "upbase-crawler-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Worker crawl độc lập cho B2C Ops Hub: kiểm tra link air đa nền tảng (TikTok, Shopee Video, Facebook, Instagram).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "check": "node src/cli.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
