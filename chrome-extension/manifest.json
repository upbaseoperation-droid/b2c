{
  "manifest_version": 3,
  "name": "Upbase B2C - KOC, TikTok, Shopee, IG, Threads & FB",
  "version": "1.4.0",
  "description": "Phân tích KOC, Shopee Video/Live, TikTok Seller/Live/Ads, nhãn lưới Gắn giỏ, quét kịch bản & tải MP4 không logo đa nền tảng.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "clipboardWrite",
    "declarativeNetRequest",
    "downloads"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "upbase_tiktok_net_rules",
        "enabled": true,
        "path": "net_rules.json"
      }
    ]
  },
  "host_permissions": [
    "https://*.tiktok.com/*",
    "https://*.tiktokshop.com/*",
    "https://*.tiktokglobalshop.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://*.tiktokv.com/*",
    "https://*.tikwm.com/*",
    "https://*.shopee.vn/*",
    "https://*.shp.ee/*",
    "https://*.susercontent.com/*",
    "https://*.shopeemobile.com/*",
    "https://*.douyin.com/*",
    "https://*.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.threads.net/*",
    "https://*.threads.com/*",
    "https://*.facebook.com/*",
    "https://*.fb.watch/*",
    "https://*.fbcdn.net/*",
    "https://*.upbase.vn/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Upbase B2C KOC, Seller, Ads & Air Link Extension",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "upbase-logo.png",
        "icon-16.png",
        "icon-32.png",
        "icon-48.png",
        "icon-128.png"
      ],
      "matches": [
        "https://*.tiktok.com/*",
        "https://*.tiktokshop.com/*",
        "https://*.tiktokglobalshop.com/*",
        "https://*.shopee.vn/*",
        "https://*.shp.ee/*",
        "https://*.douyin.com/*",
        "https://*.instagram.com/*",
        "https://*.threads.net/*",
        "https://*.threads.com/*",
        "https://*.facebook.com/*",
        "https://*.fb.watch/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "run_at": "document_start",
      "world": "MAIN",
      "matches": [
        "https://*.tiktok.com/*",
        "https://*.tiktokshop.com/*",
        "https://*.tiktokglobalshop.com/*",
        "https://*.shopee.vn/*",
        "https://*.shp.ee/*",
        "https://*.douyin.com/*",
        "https://*.instagram.com/*",
        "https://*.threads.net/*",
        "https://*.threads.com/*",
        "https://*.facebook.com/*",
        "https://*.fb.watch/*"
      ],
      "js": [
        "page-interceptor.js"
      ]
    },
    {
      "run_at": "document_idle",
      "matches": [
        "https://*.tiktok.com/*",
        "https://*.tiktokshop.com/*",
        "https://*.tiktokglobalshop.com/*",
        "https://*.shopee.vn/*",
        "https://*.shp.ee/*",
        "https://*.douyin.com/*",
        "https://*.instagram.com/*",
        "https://*.threads.net/*",
        "https://*.threads.com/*",
        "https://*.facebook.com/*",
        "https://*.fb.watch/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    },
    {
      "run_at": "document_start",
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://*.upbase.vn/*"
      ],
      "js": [
        "web-admin-bridge.js"
      ]
    }
  ]
}
